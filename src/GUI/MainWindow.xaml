<Window x:Class="VolumeBooster.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔊 系统音量增强器" Height="500" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Closing="Window_Closing">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="🔊 系统音量增强器" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <!-- 全局增益 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionHeader}" Text="全局增益"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="GlobalGainSlider" Grid.Column="0"
                        Style="{StaticResource SliderStyle}"
                        Value="100" ValueChanged="GlobalGainSlider_ValueChanged"/>
                <TextBlock Grid.Column="1" x:Name="GlobalGainLabel" 
                          Text="100%" FontSize="16" FontWeight="Bold"
                          VerticalAlignment="Center" Margin="10,0,0,0" Width="60"/>
            </Grid>
        </StackPanel>
        
        <!-- 实时电平 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionHeader}" Text="实时电平"/>
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="L:" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="LevelLeft" Height="20" 
                           Minimum="-100" Maximum="0" Value="-100" Margin="5,0"/>
                <TextBlock Grid.Column="2" x:Name="LevelLeftLabel" Text="-100 dB" 
                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="R:" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" x:Name="LevelRight" Height="20"
                           Minimum="-100" Maximum="0" Value="-100" Margin="5,0"/>
                <TextBlock Grid.Column="2" x:Name="LevelRightLabel" Text="-100 dB"
                          VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
        
        <!-- Per-App 增益 -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <Grid>
                <TextBlock Style="{StaticResource SectionHeader}" Text="Per-App 增益" HorizontalAlignment="Left"/>
                <Button Content="+ 添加" HorizontalAlignment="Right" 
                        Click="AddAppGain_Click" Width="60" Height="25" Margin="0,10,0,5"/>
            </Grid>
            <ListBox x:Name="AppGainList" Height="100" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </StackPanel>
        
        <!-- 预设 -->
        <StackPanel Grid.Row="4" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionHeader}" Text="预设"/>
            <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource PresetButton}" Content="🎵 音乐" Click="PresetMusic_Click"/>
                <Button Style="{StaticResource PresetButton}" Content="📞 微信" Click="PresetWeChat_Click"/>
                <Button Style="{StaticResource PresetButton}" Content="🎬 电影" Click="PresetMovie_Click"/>
                <Button Style="{StaticResource PresetButton}" Content="🎮 游戏" Click="PresetGame_Click"/>
            </WrapPanel>
        </StackPanel>
        
        <!-- 设置 -->
        <StackPanel Grid.Row="5" Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionHeader}" Text="设置"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" x:Name="LimiterEnabled" Content="限幅器" 
                         IsChecked="True" Checked="Limiter_Changed" Unchecked="Limiter_Changed"/>
                <CheckBox Grid.Column="1" x:Name="AutoStartEnabled" Content="开机自启"
                         Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
            </Grid>
            <Grid Margin="0,5,0,0">
                <TextBlock Text="限幅阈值:" VerticalAlignment="Center" Width="70"/>
                <ComboBox x:Name="ThresholdComboBox" Width="100" Margin="5,0" SelectionChanged="Threshold_Changed">
                    <ComboBoxItem Content="-1 dB" Tag="-1"/>
                    <ComboBoxItem Content="-3 dB" Tag="-3" IsSelected="True"/>
                    <ComboBoxItem Content="-6 dB" Tag="-6"/>
                    <ComboBoxItem Content="-10 dB" Tag="-10"/>
                </ComboBox>
                <TextBlock Text="快捷键: Ctrl+Alt+↑/↓" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnEnable" Content="🔊 增强开启" Width="120" Height="35" 
                    FontSize="14" Click="BtnEnable_Click" Margin="5"/>
            <Button x:Name="BtnDisable" Content="🔇 恢复原声" Width="120" Height="35"
                    FontSize="14" Click="BtnDisable_Click" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
