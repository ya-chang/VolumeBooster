<Window x:Class="VolumeBooster.GUI.AppGainDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 Per-App 增益" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Row="0" Text="选择应用程序:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <!-- 运行中的应用列表 -->
        <ListBox Grid.Row="1" x:Name="AppListBox" Height="150" 
                 SelectionChanged="AppListBox_SelectionChanged"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        <TextBlock Text=" (" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ProcessId}" Foreground="Gray" VerticalAlignment="Center"/>
                        <TextBlock Text=")" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 手动输入进程名 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="或手动输入:" VerticalAlignment="Center" Width="70"/>
            <TextBox x:Name="ManualProcessName" Grid.Column="1" Margin="5,0" 
                     VerticalContentAlignment="Center" Height="25"/>
        </Grid>
        
        <!-- 增益滑块 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="增益:" VerticalAlignment="Center" Width="40"/>
            <Slider x:Name="GainSlider" Minimum="0" Maximum="30" Value="6" 
                    TickFrequency="1" IsSnapToTickEnabled="True" Margin="5,0"/>
            <TextBlock x:Name="GainLabel" Text="+6 dB (200%)" 
                      VerticalAlignment="Center" Width="100" Margin="5,0"/>
        </Grid>
        
        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Height="30" Click="Ok_Click" IsDefault="True" Margin="0,0,10,0"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
